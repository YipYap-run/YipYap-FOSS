# Base image pinning (security-review A5-LOW): pin by SHA256 digest for
# reproducibility. Captured 2026-04-24.
FROM alpine:latest@sha256:5b10f432ef3da1b8d4c7eb6c487f2f5a8f096bc91145e68878dd4a5019afde11 AS certs
RUN apk --no-cache add ca-certificates
# Seed an empty data dir so a named volume mounted at /data starts out
# writable by the runtime user (scratch has no shell to mkdir/chown).
RUN mkdir -p /data && touch /data/.keep

FROM scratch
ARG TARGETPLATFORM
COPY --from=certs /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/
COPY --from=certs --chown=65534:65534 /data /data
COPY ${TARGETPLATFORM}/yipyap /yipyap
# Run as nobody, not root (core-19). /data is the working directory so the
# default relative DB path (yipyap.db) and the generated jwt_secret land in
# the writable volume. Volumes created by older root images need a one-time
# chown, see the FOSS README.
WORKDIR /data
USER 65534:65534
ENTRYPOINT ["/yipyap"]
