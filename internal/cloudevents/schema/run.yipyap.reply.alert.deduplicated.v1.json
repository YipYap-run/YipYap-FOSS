{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://console.yipyap.run/schemas/cloudevents/run.yipyap.reply.alert.deduplicated.v1.json",
  "title": "run.yipyap.reply.alert.deduplicated.v1",
  "description": "Mark an alert as a duplicate of another alert. Future notifications for this alert redirect to the primary.",
  "type": "object",
  "properties": {
    "specversion": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "source": {
      "type": "string",
      "format": "uri"
    },
    "type": {
      "const": "run.yipyap.reply.alert.deduplicated.v1"
    },
    "subject": {
      "type": "string"
    },
    "time": {
      "type": "string",
      "format": "date-time"
    },
    "data": {
      "type": "object",
      "properties": {
        "alert_id": {
          "type": "string",
          "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
          "description": "ID of the alert being marked duplicate."
        },
        "duplicate_of": {
          "type": "string",
          "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
          "description": "ID of the primary alert this one deduplicates against. Must be a real, active alert in the same org."
        },
        "reason": {
          "type": "string",
          "description": "Why the sink believes these are duplicates (e.g. \"same underlying monitor, within 30s window\")."
        }
      },
      "required": [
        "alert_id",
        "duplicate_of",
        "reason"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "specversion",
    "id",
    "source",
    "type",
    "time",
    "data"
  ],
  "additionalProperties": true
}
