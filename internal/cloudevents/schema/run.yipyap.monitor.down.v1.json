{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://console.yipyap.run/schemas/cloudevents/run.yipyap.monitor.down.v1.json",
  "title": "run.yipyap.monitor.down.v1",
  "description": "Emitted when a monitor transitions to the DOWN state.",
  "type": "object",
  "properties": {
    "specversion": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "source": {
      "type": "string",
      "format": "uri"
    },
    "type": {
      "const": "run.yipyap.monitor.down.v1"
    },
    "subject": {
      "type": "string"
    },
    "time": {
      "type": "string",
      "format": "date-time"
    },
    "data": {
      "type": "object",
      "properties": {
        "monitor_id": {
          "type": "string",
          "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "check_id": {
          "type": "string",
          "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "failure_reason": {
          "type": "string",
          "description": "Human-readable reason the check failed (e.g. \"HTTP 503\", \"timeout\", \"TLS handshake failed\")."
        },
        "checked_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "monitor_id",
        "check_id",
        "failure_reason",
        "checked_at"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "specversion",
    "id",
    "source",
    "type",
    "time",
    "data"
  ],
  "additionalProperties": true
}
