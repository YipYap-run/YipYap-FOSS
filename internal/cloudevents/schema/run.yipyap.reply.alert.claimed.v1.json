{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://console.yipyap.run/schemas/cloudevents/run.yipyap.reply.alert.claimed.v1.json",
  "title": "run.yipyap.reply.alert.claimed.v1",
  "description": "Sent by a sink to record that the alert has been claimed by a human or integration.",
  "type": "object",
  "properties": {
    "specversion": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "source": {
      "type": "string",
      "format": "uri"
    },
    "type": {
      "const": "run.yipyap.reply.alert.claimed.v1"
    },
    "subject": {
      "type": "string"
    },
    "time": {
      "type": "string",
      "format": "date-time"
    },
    "data": {
      "type": "object",
      "properties": {
        "alert_id": {
          "type": "string",
          "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
          "description": "ID of the alert being claimed. Must match the ce_alertref extension on the reply envelope."
        },
        "who": {
          "type": "string",
          "description": "Display name or identifier of the claimant. Paired with the verified OIDC sub for audit."
        },
        "claimed_at": {
          "type": "string",
          "format": "date-time"
        },
        "note": {
          "type": "string",
          "description": "Optional free-form note explaining the claim (e.g. \"taking this one, paging me\")."
        }
      },
      "required": [
        "alert_id",
        "who",
        "claimed_at"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "specversion",
    "id",
    "source",
    "type",
    "time",
    "data"
  ],
  "additionalProperties": true
}
