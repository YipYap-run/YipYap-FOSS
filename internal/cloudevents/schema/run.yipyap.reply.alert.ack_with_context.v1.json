{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://console.yipyap.run/schemas/cloudevents/run.yipyap.reply.alert.ack_with_context.v1.json",
  "title": "run.yipyap.reply.alert.ack_with_context.v1",
  "description": "Rich acknowledgement carrying a reason code and optional free-form note. Transitions the alert to ACKED state.",
  "type": "object",
  "properties": {
    "specversion": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "source": {
      "type": "string",
      "format": "uri"
    },
    "type": {
      "const": "run.yipyap.reply.alert.ack_with_context.v1"
    },
    "subject": {
      "type": "string"
    },
    "time": {
      "type": "string",
      "format": "date-time"
    },
    "data": {
      "type": "object",
      "properties": {
        "alert_id": {
          "type": "string",
          "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "reason_code": {
          "type": "string",
          "enum": [
            "resolved_by_deploy",
            "duplicate_of",
            "known_issue",
            "investigating",
            "false_positive",
            "transient",
            "other"
          ],
          "description": "Structured reason for the ack. Feeds alert-pattern analytics."
        },
        "note": {
          "type": "string",
          "description": "Free-form elaboration."
        },
        "reference_id": {
          "type": "string",
          "description": "Optional ID for reason_codes that reference another system (e.g. deploy sha for resolved_by_deploy, ticket ID for known_issue)."
        }
      },
      "required": [
        "alert_id",
        "reason_code"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "specversion",
    "id",
    "source",
    "type",
    "time",
    "data"
  ],
  "additionalProperties": true
}
