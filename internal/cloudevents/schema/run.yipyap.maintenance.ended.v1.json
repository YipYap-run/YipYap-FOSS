{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://console.yipyap.run/schemas/cloudevents/run.yipyap.maintenance.ended.v1.json",
  "title": "run.yipyap.maintenance.ended.v1",
  "description": "Emitted when a maintenance window ends (scheduled or early termination).",
  "type": "object",
  "properties": {
    "specversion": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "source": {
      "type": "string",
      "format": "uri"
    },
    "type": {
      "const": "run.yipyap.maintenance.ended.v1"
    },
    "subject": {
      "type": "string"
    },
    "time": {
      "type": "string",
      "format": "date-time"
    },
    "data": {
      "type": "object",
      "properties": {
        "window_id": {
          "type": "string",
          "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "ended_at": {
          "type": "string",
          "format": "date-time"
        },
        "ended_early": {
          "type": "boolean",
          "description": "True when the window was closed before its scheduled end."
        }
      },
      "required": [
        "window_id",
        "ended_at"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "specversion",
    "id",
    "source",
    "type",
    "time",
    "data"
  ],
  "additionalProperties": true
}
