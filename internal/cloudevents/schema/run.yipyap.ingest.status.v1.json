{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://console.yipyap.run/schemas/cloudevents/run.yipyap.ingest.status.v1.json",
  "title": "run.yipyap.ingest.status.v1",
  "description": "Ingested to set a monitor's status explicitly.",
  "type": "object",
  "properties": {
    "specversion": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "source": {
      "type": "string",
      "format": "uri"
    },
    "type": {
      "const": "run.yipyap.ingest.status.v1"
    },
    "subject": {
      "type": "string"
    },
    "time": {
      "type": "string",
      "format": "date-time"
    },
    "data": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "up",
            "down",
            "degraded"
          ]
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "status"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "specversion",
    "id",
    "source",
    "type",
    "time",
    "data"
  ],
  "additionalProperties": true
}
